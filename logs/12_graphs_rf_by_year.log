. 
. *----------------------------------------------------------------------------
> ---
. * 2. Regressions and graphs, once for ShareWm and once for OneWm
. *    areg ..., absorb(firmid) = firm fixed effects; s.e. clustered by firm.
. *----------------------------------------------------------------------------
> ---
. foreach x in ShareWm OneWm {
  2. 
.     display _newline(2) as text "{hline 78}"
  3.     display as text "REDUCED FORM: ln(mktcap) on `x'"
  4.     display as text "{hline 78}"
  5. 
.     * (1) no fixed effects
.     reg lnmktcap `x', vce(cluster gvkey)
  6.     estimates store r1_`x'
  7. 
.     * (2) firm fixed effects  <-- your equation
.     areg lnmktcap `x', absorb(firmid) vce(cluster gvkey)
  8.     estimates store r2_`x'
  9.     local b2  = _b[`x']
 10.     local se2 = _se[`x']
 11. 
.     * (3) firm AND year fixed effects
.     areg lnmktcap `x' i.pyear, absorb(firmid) vce(cluster gvkey)
 12.     estimates store r3_`x'
 13. 
.     estimates table r1_`x' r2_`x' r3_`x', keep(`x') b(%9.4f) se(%9.4f) ///
>         stats(N r2) title("Reduced form: ln(mktcap) on `x'")
 14. 
.     local fn = lower("`x'")
 15.     if "`x'" == "ShareWm" {
 16.         local xt  "Percent women on board"
 17.         local xtr "Percent women on board (residual, after firm fixed effe
> cts)"
 18.         local ttl "Firm Value and Percent Women on the Board"
 19.     }
 20.     else {
 21.         local xt  "At least 1 woman on board"
 22.         local xtr "At least 1 woman on board (residual, after firm fixed e
> ffects)"
 23.         local ttl "Firm Value and Having a Woman on the Board"
 24.     }
 25. 
.     *------------------------------------------------------------------------
> ---
.     * 3. MAIN GRAPH: binned partial-regression plot. ln(mktcap) and `x' are b
> oth
.     *    residualized on firm fixed effects, cut into 20 bins by the residual
> ized
.     *    `x', and the bin averages are plotted with a fitted line. The slope 
> of
.     *    the line is the coefficient b1 from column (2).
.     *------------------------------------------------------------------------
> ---
.     preserve
 26.     quietly areg lnmktcap, absorb(firmid)
 27.     predict double ry, dresiduals
 28.     quietly areg `x', absorb(firmid)
 29.     predict double rx, dresiduals
 30. 
.     xtile bin = rx, nq(20)
 31.     collapse (mean) ry rx, by(bin)
 32. 
.     local bb : display %6.3f `b2'
 33.     local ss : display %6.3f `se2'
 34. 
.     gr two (scatter ry rx, msize(medlarge)) ///
>            (lfit ry rx), ///
>         legend(off) ///
>         xtitle("`xtr'") ///
>         ytitle("ln(market cap) (residual, after firm fixed effects)") ///
>         title("`ttl'", size(medium)) ///
>         note("Binned means (20 bins), firm-year data, CA and TX firms. Slope 
> = `bb' (clustered s.e. `ss').")
 35.     graph export "output/figures/lnmktcap_`fn'_binned.png", replace width(
> 2000)
 36.     graph save   "output/figures/lnmktcap_`fn'_binned.gph", replace
 37.     restore
 38. 
.     *------------------------------------------------------------------------
> ---
.     * 4. SECONDARY GRAPH (replaces the event study): the slope on `x' in each
.     *    year, with firm and year fixed effects. Each point is the coefficien
> t
.     *    on `x' x 1[year = t]; the bars are 95% CIs, s.e. clustered by firm.
.     *------------------------------------------------------------------------
> ---
.     forvalues t = `firstyr'/`lastyr' {
 39.         gen xyr`t' = `x' * (pyear == `t')
 40.     }
 41. 
.     areg lnmktcap xyr* i.pyear, absorb(firmid) vce(cluster gvkey)
 42. 
.     gen slope = .
 43.     gen se    = .
 44.     forvalues t = `firstyr'/`lastyr' {
 45.         replace slope = _b[xyr`t']  if pyear == `t'
 46.         replace se    = _se[xyr`t'] if pyear == `t'
 47.     }
 48. 
.     * check the numbers before plotting
.     tabstat slope se, by(pyear) stat(mean) nototal
 49. 
.     preserve
 50.     collapse (mean) slope se, by(pyear)
 51.     gen upper = slope + 1.96*se
 52.     gen lower = slope - 1.96*se
 53. 
.     gr two (scatter slope pyear, yline(0, lc(black))) ///
>            (rcap upper lower pyear, xline(2017.5, lp(dash))), ///
>         legend(off) ///
>         xlabel(`firstyr'(1)`lastyr') ///
>         xtitle("Fiscal year (calendar year of fiscal year end; SB 826 applies
>  from FY2018)") ///
>         ytitle("Coefficient on `xt' (outcome: ln market cap)") ///
>         title("Reduced Form by Year" "ln(market cap) on `xt'", size(medium)) 
> ///
>         note("Firm-year data, CA and TX firms, firm and year fixed effects." 
> ///
>              "Bars show 95% confidence intervals, standard errors clustered b
> y firm. Dashed line = SB 826 signed 30 Sep 2018.")
 54.     graph export "output/figures/lnmktcap_`fn'_byyear.png", replace width(
> 2000)
 55.     graph save   "output/figures/lnmktcap_`fn'_byyear.gph", replace
 56.     restore
 57. 
.     drop xyr* slope se
 58. }


