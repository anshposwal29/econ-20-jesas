     Total |     3,760      4,868 |     8,628 

. quietly levelsof gvkey

. di "Firm-years: " _N "   Firms: " r(r)
Firm-years: 8628   Firms: 1340

. quietly levelsof sic2

. di "2-digit SIC industries: " r(r)
2-digit SIC industries: 59

. 
. *----------------------------------------------------------------------------
> ---
. * 1. CA x year interactions (2018 omitted)
. *----------------------------------------------------------------------------
> ---
. forvalues t = `firstyr'/`lastyr' {
  2.     if `t' != `refyr' {
  3.         gen caXyr`t' = ca * (pyear == `t')
  4.     }
  5. }

. local pretest ""

. forvalues t = `firstyr'/`=`refyr'-1' {
  2.     local pretest `pretest' caXyr`t'
  3. }

. 
. *----------------------------------------------------------------------------
> ---
. * 2. Event studies: firm FE (absorbed) + industry x year FE, cluster by firm
. *----------------------------------------------------------------------------
> ---
. foreach v in lnmktcap ShareWm {
  2. 
.     if "`v'" == "lnmktcap" {
  3.         local ttl  "Reduced Form: ln(Market Cap)"
  4.         local ylab "CA - TX difference in ln(market cap)"
  5.     }
  6.     if "`v'" == "ShareWm" {
  7.         local ttl  "First Stage: Women as % of Board"
  8.         local ylab "CA - TX difference in % women on board"
  9.     }
 10. 
.     di _n "=================== Event study: `v' ==================="
 11.     areg `v' caXyr* i.ind#i.pyear, absorb(gvkey) vce(cluster gvkey)
 12.     di _n "Joint test of no pre-trends (`v'):"
 13.     test `pretest'
 14.     local p_pre = r(p)
 15. 
.     preserve
 16.     clear
 17.     set obs `=`lastyr' - `firstyr' + 1'
 18.     gen pyear = `firstyr' + _n - 1
 19.     gen slope = 0                    // reference year = 0, no CI
 20.     gen se    = .
 21.     forvalues t = `firstyr'/`lastyr' {
 22.         if `t' != `refyr' {
 23.             replace slope = _b[caXyr`t']  if pyear == `t'
 24.             replace se    = _se[caXyr`t'] if pyear == `t'
 25.         }
 26.     }
 27.     gen upper = slope + 1.96*se
 28.     gen lower = slope - 1.96*se
 29.     list pyear slope se, noobs clean
 30. 
.     gr two (rcap upper lower pyear, lcolor(cranberry)) ///
>            (scatter slope pyear, mcolor(navy) msymbol(circle)), ///
>         yline(0, lc(black)) xline(2018.5, lp(dash) lc(gs6)) ///
>         legend(off) ///
>         xlabel(`firstyr'(1)`lastyr') ///
>         xtitle("Policy year (runs 1 Oct - 30 Sep; 2019 = first year after SB 
> 826)") ///
>         ytitle("`ylab'" "relative to 2018") ///
>         title("`ttl'" "Firm and Industry-by-Year Fixed Effects", size(medium)
> ) ///
>         note("CA vs. TX firm-years with board data. Firm FE and 2-digit SIC x
>  year FE; 2018 is the omitted year." ///
>              "95% CIs, SEs clustered by firm. Pre-trend joint test p = `: di 
> %4.3f `p_pre''. Dashed line = SB 826 signed 30 Sep 2018.")
 31.     graph export "output/figures/es_`v'_fe.png", replace width(2000)
 32.     graph save   "output/figures/es_`v'_fe.gph", replace
 33.     restore
 34. }

