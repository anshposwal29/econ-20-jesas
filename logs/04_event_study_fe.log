. *----------------------------------------------------------------------------
> ---
. * 3. Companion graphs: raw means by state and year, 95% CIs
. *    (no fixed effects -- these show the levels behind the event studies)
. *    CA is shifted 0.08 left and TX 0.08 right so the bars do not overlap.
. *----------------------------------------------------------------------------
> ---
. foreach v in lnmktcap ShareWm {
  2.     if "`v'" == "lnmktcap" local ylab "Mean ln(market cap, $ millions)"
  3.     if "`v'" == "ShareWm"  local ylab "Mean women as % of board"
  4.     if "`v'" == "lnmktcap" local ttl  "Mean ln(Market Cap), California vs.
>  Texas"
  5.     if "`v'" == "ShareWm"  local ttl  "Women as % of Board, California vs.
>  Texas"
  6. 
.     preserve
  7.     collapse (mean) m=`v' (semean) s=`v', by(ca pyear)
  8.     gen upper = m + 1.96*s
  9.     gen lower = m - 1.96*s
 10.     gen x = pyear + cond(ca == 1, -0.08, 0.08)
 11. 
.     gr two (rcap upper lower x if ca==1, lcolor(navy)) ///
>            (rcap upper lower x if ca==0, lcolor(cranberry)) ///
>            (connected m x if ca==1, lcolor(navy) mcolor(navy)) ///
>            (connected m x if ca==0, lcolor(cranberry) mcolor(cranberry) msymb
> ol(square)), ///
>         xline(2018.5, lp(dash) lc(gs6)) ///
>         legend(order(3 "California" 4 "Texas") rows(1) position(6)) ///
>         xlabel(`firstyr'(1)`lastyr') ///
>         xtitle("Policy year (runs 1 Oct - 30 Sep; 2019 = first year after SB 
> 826)") ///
>         ytitle("`ylab'") ///
>         title("`ttl'", size(medium)) ///
>         note("Raw means, no fixed effects. Same firm-years as the event studi
> es. Bars show 95% CIs." ///
>              "The set of firms changes over time (e.g. new CA biotech listing
> s after 2018).")
 12.     graph export "output/figures/means_`v'.png", replace width(2000)
 13.     graph save   "output/figures/means_`v'.gph", replace
 14.     restore
 15. }
