. 
. use "final_data.dta", clear
((null))

. 
. *----------------------------------------------------------------------------
> ---
. * 0. Variables and sample
. *----------------------------------------------------------------------------
> ---
. * ShareWm = percent of the board that is women (0-100), as in FirstStageShare
> Wm
. gen ShareWm = 100 * women / boardsize if women < . & boardsize < . & boardsiz
> e > 0
(2,268 missing values generated)

. label var ShareWm "Women as % of board"

. 
. * policy year runs 1 Oct - 30 Sep; pyear 2019 = first post year
. gen pyear = year(fye) + (month(fye) >= 10)

. assert (pyear >= 2019) == post

. 
. local refyr   2018

. local firstyr 2011

. local lastyr  2021

. keep if inrange(pyear, `firstyr', `lastyr')
(5,164 observations deleted)

. 
. * same firm-years for both outcomes
. keep if ShareWm < . & lnmktcap < .
(1,158 observations deleted)

. 
. egen ind = group(sic2)

. label var ind "2-digit SIC industry"

. 
. tab pyear ca

           |      =1 if HQ in
           | California on 30 Sep
           |   2018 (0 = Texas)
     pyear |         0          1 |     Total
-----------+----------------------+----------
      2011 |       327        409 |       736 
      2012 |       326        418 |       744 
      2013 |       328        411 |       739 
      2014 |       333        426 |       759 
