. *==============================================================
. * HELPER PROGRAM: 2x2 means graph (collapse + gr two + rcap)
. * CA vs TX, 2018 vs 2019, with 95% CI bars and raw DiD in the note.
. * With no controls, the raw DiD equals the regression coefficient on
. * ca_post19 (the 2x2 regression is saturated), so it is posted too.
. *==============================================================
. capture program drop did_means

. program define did_means
  1.     syntax varname [if], TTL(string) YTTL(string) FNAME(string)
  2.     preserve
  3.     if "`if'" != "" keep `if'
  4.     quietly count if `varlist' < .
  5.     local N = r(N)
  6.     collapse (mean) m=`varlist' (semean) se=`varlist', by(ca fyr)
  7.     gen upper = m + 1.96*se
  8.     gen lower = m - 1.96*se
  9.     gen x = fyr + cond(ca==1, .03, -.03)      // small offset so bars do n
> ot overlap
 10.     sort ca fyr
 11.     * obs 1=TX2018, 2=TX2019, 3=CA2018, 4=CA2019
.     local didraw = (m[4]-m[3]) - (m[2]-m[1])
 12.     local fig = subinstr("`fname'", ".png", "", .)
 13.     post fignums ("`fig'") ("raw_did") (`didraw') (.) (`N')
 14.     local did : display %6.3f `didraw'
 15.     gr two (line m x if ca==1) ///
>            (line m x if ca==0, xline(2018.5, lp(dash))) ///
>            (rcap upper lower x if ca==1) ///
>            (rcap upper lower x if ca==0), ///
>         legend(label(1 "California") label(2 "Texas") order(1 2)) ///
>         title("`ttl'", size(medium)) ytitle("`yttl'") xtitle("Fiscal year") /
> //
>         xlabel(2018 "2018 (pre)" 2019 "2019 (post)") xscale(range(2017.7 2019
> .3)) ///
>         note("Raw DiD (CA change - TX change) = `did'. Bars show 95% confiden
> ce intervals.")
 16.     graph export "output/figures/`fname'", replace width(1600)
 17.     restore
 18. end

. 
