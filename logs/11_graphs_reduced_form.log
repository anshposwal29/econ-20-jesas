>     legend(label(1 "California") label(2 "Texas") order(1 2)) ///
>     xlabel(`firstyr'(1)`lastyr') ///
>     xtitle("Fiscal year (calendar year of fiscal year end; SB 826 applies fro
> m FY2018)") ///
>     ytitle("Average ln(market capitalization)") ///
