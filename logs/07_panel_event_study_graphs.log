. capture drop evCA*

. forvalues t = `firstyr'/`lastyr' {
  2.     if `t' != `refyr' {
  3.         gen evCA`t' = ca * (fyr == `t')
  4.     }
  5. }

. 
. foreach y in onewoman lnmktcap {
  2. 
.     * original (o) and detrended (d) event studies, same sample
.     foreach v in `y' `y'_hat {
  3.         local s = cond("`v'" == "`y'", "o", "d")
  4. 
.         xtreg `v' evCA* i.fyr if onewoman ~= . & fyr >= `firstyr' & fyr <= `l
> astyr', ///
>             fe cluster(firm_id)
  5. 
.         capture drop b_`s' se_`s'
  6.         gen b_`s'  = 0
  7.         gen se_`s' = .
  8.         forvalues t = `firstyr'/`lastyr' {
  9.             if `t' != `refyr' {
 10.                 replace b_`s'  = _b[evCA`t']  if fyr == `t'
 11.                 replace se_`s' = _se[evCA`t'] if fyr == `t'
 12.             }
 13.         }
 14.     }
 15. 
.     if "`y'" == "onewoman" {
 16.         local ttl "First Stage Event Study"
 17.         local yt  "CA - TX difference in P(at least 1 woman), relative to 
> 2017"
 18.     }
 19.     else {
 20.         local ttl "Reduced Form Event Study"
 21.         local yt  "CA - TX difference in ln(market cap), relative to 2017"
 22.     }
 23. 
.     preserve
 24.     keep if fyr >= `firstyr' & fyr <= `lastyr'
 25.     collapse (mean) b_o se_o b_d se_d, by(fyr)
 26.     foreach s in o d {
 27.         gen up_`s' = b_`s' + 1.96*se_`s'
 28.         gen lo_`s' = b_`s' - 1.96*se_`s'
 29.     }
 30.     gen x_o = fyr - 0.12
 31.     gen x_d = fyr + 0.12
 32. 
.     gr two (rcap up_o lo_o x_o, lc(gs11)) (scatter b_o x_o, mc(gs8) ms(Oh)) /
> //
>            (rcap up_d lo_d x_d, lc(cranberry)) (scatter b_d x_d, mc(blue) ms(
> O)), ///
>         yline(0, lc(black) lp(dash)) xline(2017.5, lp(dash) lc(black)) ///
>         legend(order(2 "Original" 4 "Detrended (CA linear pre-trend removed)"
> ) ring(0) pos(11)) ///
>         xlabel(`firstyr'(2)`lastyr') ///
>         xtitle("Fiscal year (calendar year of fiscal year end; SB 826 applies
>  from FY2018)") ///
>         ytitle("`yt'") ///
>         title("`ttl'" "California SB 826: Original vs. Detrended", size(mediu
> m)) ///
>         note("CA-specific linear trend estimated on pre-law observations (pos
> t==0) and removed from the outcome." ///
>              "Bars show 95% CIs, standard errors clustered by firm. Dashed li
> ne = SB 826 signed 30 Sep 2018.")
 33.     graph export "output/figures/es_`y'_overlay.png", replace width(2000)
 34.         graph save   "output/figures/es_`y'_overlay.gph", replace
 35.     restore
 36. }

