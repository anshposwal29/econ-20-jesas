. *==============================================================
. * GRAPH 1: first stage, original vs detrended
. *==============================================================
. preserve

. keep if fyr >= 2011 & fyr <= 2020
(0 observations deleted)

. collapse (mean) b_onewoman se_onewoman b_onewoman_hat se_onewoman_hat, by(fyr
> )

. gen upper = b_onewoman + 1.96*se_onewoman
(1 missing value generated)

. gen lower = b_onewoman - 1.96*se_onewoman
(1 missing value generated)

. gen upper_hat = b_onewoman_hat + 1.96*se_onewoman_hat
(1 missing value generated)

. gen lower_hat = b_onewoman_hat - 1.96*se_onewoman_hat
(1 missing value generated)

. * move the two series slightly apart so the bars do not overlap
. gen x = fyr - 0.12

. gen x_hat = fyr + 0.12

. 
. gr two (rcap upper lower x, lc(gs11)) (scatter b_onewoman x, mc(gs8) ms(Oh)) 
> ///
>        (rcap upper_hat lower_hat x_hat, lc(cranberry)) (scatter b_onewoman_ha
> t x_hat, mc(blue) ms(O)), ///
>     yline(0, lc(black) lp(dash)) xline(2017.5, lp(dash) lc(black)) ///
>     legend(order(2 "Original" 4 "Detrended (CA linear pre-trend removed)") ri
> ng(0) pos(11)) ///
>     xlabel(2011(1)2020) ///
>     xtitle("Fiscal year (calendar year of fiscal year end; SB 826 applies fro
> m FY2018)") ///
>     ytitle("CA - TX difference in P(at least 1 woman), relative to 2017") ///
>     title("First Stage Event Study" "California SB 826: Original vs. Detrende
> d", size(medium)) ///
>     note("CA-specific linear trend estimated on pre-law observations (post==0
> ) and removed from the outcome." ///
>          "Bars show 95% CIs, standard errors clustered by firm. Dashed line =
>  SB 826 signed 30 Sep 2018.")

