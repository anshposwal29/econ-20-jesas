. *----------------------------------------------------------------------------
> ---
. * One combined file: variable, means and SDs before and after the law by
. * state, pre-law diff (se, p, N), DiD b3 (se, p, N). 03_table1_format.py
. * turns this into the formatted Table 1.
. *----------------------------------------------------------------------------
> ---
. tempname h

. postfile `h' str20 variable mean_ca sd_ca mean_tx sd_tx ///
>     mean_ca_post sd_ca_post mean_tx_post sd_tx_post ///
>     diff diff_se diff_p diff_n did did_se did_p did_n ///
>     using "temp/table1_balance.dta", replace

. 
. foreach v in `meansonly' `balance' {
  2.     quietly summarize `v' if post == 0 & ca == 1
  3.     local m1 = r(mean)
  4.     local s1 = r(sd)
  5.     quietly summarize `v' if post == 0 & ca == 0
  6.     local m0 = r(mean)
  7.     local s0 = r(sd)
  8.     quietly summarize `v' if post == 1 & ca == 1
  9.     local m1p = r(mean)
 10.     local s1p = r(sd)
 11.     quietly summarize `v' if post == 1 & ca == 0
 12.     local m0p = r(mean)
 13.     local s0p = r(sd)
 14.     * balance regressions for the balance variables only
.     local isbal : list v in balance
 15.     if `isbal' {
 16.         quietly reg `v' ca if post == 0, vce(cluster gvkey)
 17.         local b  = _b[ca]
 18.         local se = _se[ca]
 19.         local p  = 2 * ttail(e(df_r), abs(`b' / `se'))
 20.         local n  = e(N)
 21.         quietly reg `v' ca post ca_post, vce(cluster gvkey)
 22.         local b3  = _b[ca_post]
 23.         local se3 = _se[ca_post]
 24.         local p3  = 2 * ttail(e(df_r), abs(`b3' / `se3'))
 25.         local n3  = e(N)
 26.     }
 27.     else {
 28.         local b   = .
 29.         local se  = .
 30.         local p   = .
 31.         local n   = .
 32.         local b3  = .
 33.         local se3 = .
 34.         local p3  = .
 35.         local n3  = .
 36.     }
 37.     post `h' ("`v'") (`m1') (`s1') (`m0') (`s0') ///
>         (`m1p') (`s1p') (`m0p') (`s0p') ///
>         (`b') (`se') (`p') (`n') (`b3') (`se3') (`p3') (`n3')
 38. }

. postclose `h'

. 
. * firm-year and firm counts for each of the four groups (last rows of Table 1
> )
. foreach g in "0 0" "0 1" "1 0" "1 1" {
  2.     local c : word 1 of `g'
  3.     local p : word 2 of `g'
  4.     count if ca == `c' & post == `p'
  5.     local fy_`c'`p' = r(N)
  6.     quietly tab gvkey if ca == `c' & post == `p'
  7.     local f_`c'`p' = r(r)
  8. }
  3,108
  716
  4,032
  906

. display "Firm-years  TX pre `fy_00'  TX post `fy_01'  CA pre `fy_10'  CA post
>  `fy_11'"
Firm-years  TX pre 3108  TX post 716  CA pre 4032  CA post 906

. display "Firms       TX pre `f_00'   TX post `f_01'   CA pre `f_10'   CA post
>  `f_11'"
Firms       TX pre 535   TX post 398   CA pre 748   CA post 551

. quietly tab gvkey if post == 0

. local f_pre = r(r)

. quietly tab gvkey

. local f_all = r(r)

. 
. use "temp/table1_balance.dta", clear

. local N = _N + 2

. set obs `N'
Number of observations (_N) was 15, now 17.

. replace variable = "firm_years" in `=_N-1'
(1 real change made)

. replace mean_ca = `fy_10' in `=_N-1'
(1 real change made)

. replace mean_tx = `fy_00' in `=_N-1'
(1 real change made)

. replace mean_ca_post = `fy_11' in `=_N-1'
(1 real change made)

. replace mean_tx_post = `fy_01' in `=_N-1'
(1 real change made)

. replace diff_n = `fy_00' + `fy_10' in `=_N-1'
