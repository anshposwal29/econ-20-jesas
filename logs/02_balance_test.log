. *----------------------------------------------------------------------------
> ---
. * All columns in one file, one row per variable: means and SDs by state befor
> e
. * and after the law, the pre-law difference (b, se, p, N) and the DiD (b, se,
>  p, N).
. * not from class: postfile collects one row per variable into a new dataset.
. *----------------------------------------------------------------------------
> ---
. tempname h

. postfile `h' str20 variable mean_ca sd_ca mean_tx sd_tx ///
>     mean_ca_post sd_ca_post mean_tx_post sd_tx_post ///
>     diff diff_se diff_p diff_n did did_se did_p did_n ///
>     using "temp/table1_balance.dta", replace

. 
. * means-only variables: no regressions, so those columns are missing
. foreach v of local meansonly {
  2.     quietly summarize `v' if post == 0 & ca == 1
  3.     local m1 = r(mean)
  4.     local s1 = r(sd)
  5.     quietly summarize `v' if post == 0 & ca == 0
  6.     local m0 = r(mean)
  7.     local s0 = r(sd)
  8.     quietly summarize `v' if post == 1 & ca == 1
  9.     local m1p = r(mean)
 10.     local s1p = r(sd)
 11.     quietly summarize `v' if post == 1 & ca == 0
 12.     local m0p = r(mean)
 13.     local s0p = r(sd)
 14.     post `h' ("`v'") (`m1') (`s1') (`m0') (`s0') ///
>         (`m1p') (`s1p') (`m0p') (`s0p') ///
>         (.) (.) (.) (.) (.) (.) (.) (.)
 15. }

. 
. * balance variables: means plus the two regressions above
. foreach v of local balance {
  2.     quietly summarize `v' if post == 0 & ca == 1
  3.     local m1 = r(mean)
  4.     local s1 = r(sd)
  5.     quietly summarize `v' if post == 0 & ca == 0
  6.     local m0 = r(mean)
  7.     local s0 = r(sd)
  8.     quietly summarize `v' if post == 1 & ca == 1
  9.     local m1p = r(mean)
 10.     local s1p = r(sd)
 11.     quietly summarize `v' if post == 1 & ca == 0
 12.     local m0p = r(mean)
 13.     local s0p = r(sd)
 14.     * pre-law difference
.     quietly reg `v' ca if post == 0, cluster(gvkey)
 15.     local b  = _b[ca]
 16.     local se = _se[ca]
 17.     local p  = 2 * ttail(e(df_r), abs(`b' / `se'))
 18.     local n  = e(N)
 19.     * diff-in-diff
.     quietly reg `v' ca post ca_post, cluster(gvkey)
 20.     local b3  = _b[ca_post]
 21.     local se3 = _se[ca_post]
 22.     local p3  = 2 * ttail(e(df_r), abs(`b3' / `se3'))
 23.     local n3  = e(N)
 24.     post `h' ("`v'") (`m1') (`s1') (`m0') (`s0') ///
>         (`m1p') (`s1p') (`m0p') (`s0p') ///
>         (`b') (`se') (`p') (`n') (`b3') (`se3') (`p3') (`n3')
 25. }

. postclose `h'

. 
. * firm-years and firms in each of the four groups (last two rows of Table 1)
. count if ca == 0 & post == 0
  3,104

. local fy_tx_pre = r(N)

. count if ca == 0 & post == 1
  776

. local fy_tx_post = r(N)

. count if ca == 1 & post == 0
  4,011

. local fy_ca_pre = r(N)

. count if ca == 1 & post == 1
  1,080

. local fy_ca_post = r(N)

. 
. * r(r) after tab = number of different firms
. quietly tab gvkey if ca == 0 & post == 0

. local f_tx_pre = r(r)

. quietly tab gvkey if ca == 0 & post == 1

. local f_tx_post = r(r)

. quietly tab gvkey if ca == 1 & post == 0

. local f_ca_pre = r(r)

. quietly tab gvkey if ca == 1 & post == 1

. local f_ca_post = r(r)

. quietly tab gvkey if post == 0

. local f_pre = r(r)

. quietly tab gvkey

