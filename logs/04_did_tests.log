. *==================================================================
. * TWO-PERIOD DID SAMPLE
. *==================================================================
. keep if fyr==2018 | fyr==2019
(13,151 observations deleted)

. 
. gen post19    = (fyr==2019)

. gen ca_post19 = ca*post19

. 
. gen onewoman   = (women >= 1) if women ~= .
(184 missing values generated)

. gen sharewoman = women / boardsize if women ~= . & boardsize ~= . & boardsize
>  > 0
(184 missing values generated)

. 
. gen woman_obs = (women >= 1) if fyr==2018
(908 missing values generated)

. bysort firm_id: egen woman18 = max(woman_obs)
(69 missing values generated)

. 
