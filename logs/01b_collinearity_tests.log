> ---
. * TEST 3. Missing data by state, and whether age is missing at random
. *----------------------------------------------------------------------------
> ---
. putexcel set "`file'", modify sheet("Missing")

. putexcel A1 = "Variable" B1 = "Share missing, California" C1 = "Share missing
> , Texas"
file output/collinearity_tests.xlsx saved

. 
. local row = 2

. foreach v of local cand {
  2.     quietly count if ca == 1
  3.     local n1 = r(N)
  4.     quietly count if ca == 1 & missing(`v')
  5.     local m1 = r(N) / `n1'
  6.     quietly count if ca == 0
  7.     local n0 = r(N)
  8.     quietly count if ca == 0 & missing(`v')
  9.     local m0 = r(N) / `n0'
 10.     putexcel A`row' = "`v'" B`row' = `m1' C`row' = `m0'
 11.     local ++row
 12. }
file output/collinearity_tests.xlsx saved
