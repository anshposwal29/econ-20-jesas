. * TEST 3. Share of firm-years missing each variable, by state
. *----------------------------------------------------------------------------
> ---
. putexcel set "output/collinearity_tests.xlsx", modify sheet("Missing")

. putexcel A1 = "Variable" B1 = "Share missing, California" C1 = "Share missing
> , Texas"
file output/collinearity_tests.xlsx saved

. 
. quietly count if ca == 1

. local n_ca = r(N)

. quietly count if ca == 0

. local n_tx = r(N)

. 
. local row = 2

. foreach v in lnsale lnemp lnassets roa leverage multinational age nyse tech /
> //
>     energy boardsize pharma fin rd women zerowomen {
  2.     quietly count if ca == 1 & missing(`v')
  3.     local m_ca = r(N) / `n_ca'
  4.     quietly count if ca == 0 & missing(`v')
  5.     local m_tx = r(N) / `n_tx'
  6.     putexcel A`row' = "`v'" B`row' = `m_ca' C`row' = `m_tx'
  7.     local row = `row' + 1
  8. }
