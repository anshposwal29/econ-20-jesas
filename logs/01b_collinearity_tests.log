. *----------------------------------------------------------------------------
> ---
. * TEST 2. Variance inflation factors. A VIF depends only on the right-hand-si
> de
. *   variables, so the outcome used here does not matter. rd is left out of th
> e
. *   all-candidates run because it is missing for 43% of firm-years.
. *----------------------------------------------------------------------------
> ---
. putexcel set "`file'", modify sheet("VIF")

. putexcel A1 = "Specification" B1 = "Variable" C1 = "VIF" D1 = "Observations"
file output/collinearity_tests.xlsx saved

. 
. local row = 2

. local rdname rd

. local allcand : list cand - rdname

. 
. foreach spec in allcand final finalnoage {
  2.     if "`spec'" == "allcand" {
  3.         local xs `allcand'
  4.         local name "All candidates except rd"
  5.     }
  6.     if "`spec'" == "final" {
  7.         local xs `final'
  8.         local name "Final list"
  9.     }
 10.     if "`spec'" == "finalnoage" {
 11.         local noage age
 12.         local xs : list final - noage
 13.         local name "Final list without age (larger sample)"
 14.     }
 15.     quietly regress lnmktcap `xs'
 16.     local n = e(N)
 17.     estat vif
 18.     local k : word count `xs'
 19.     forvalues i = 1/`k' {
 20.         putexcel A`row' = "`name'" B`row' = "`r(name_`i')'" ///
>                  C`row' = `r(vif_`i')' D`row' = `n'
 21.         local ++row
 22.     }
 23. }

